rules_version = '2';

// Meteora Agro - regras do Firestore (plano gratuito Spark, sem Cloud Functions).
// As regras SAO o backend: validam quem pode gravar o que, a aprovacao de cadastro e os limites do plano.
//
// Quem grava:
//   - produtor aprovado: suas propriedades e estacoes (campos de cadastro);
//   - estacao de campo (login proprio, "dispositivo"): as horas medidas e a leitura atual da SUA estacao;
//   - administrador: aprovacao/plano dos usuarios e a rede publica;
//   - job horario do GitHub (Admin SDK, ignora as regras): dados importados, resumos, previsao.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- quem e quem
    function logado() { return request.auth != null; }
    function caminhoUsuario() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function perfil() { return get(caminhoUsuario()).data; }
    function ativo() { return logado() && exists(caminhoUsuario()) && perfil().status == 'active'; }
    function admin() { return ativo() && perfil().role == 'admin'; }
    function estacao(sid) { return get(/databases/$(database)/documents/stations/$(sid)).data; }
    function dispositivoDe(sid) { return logado() && estacao(sid).get('deviceUid', null) == request.auth.uid; }
    function legivel(sid) {
      let e = estacao(sid);
      return e.public == true || (ativo() && e.owner == request.auth.uid) || admin() || (logado() && e.get('deviceUid', null) == request.auth.uid);
    }

    // ---------------------------------------------------------------- limites do plano (IDs de vaga: {uid}_p_{n} e {uid}_e_{n})
    function limite(tipo) {
      let p = perfil().plan;
      return tipo == 'p'
        ? (p == 'enterprise' ? 100 : (p == 'pro' ? 5 : 1))
        : (p == 'enterprise' ? 200 : (p == 'pro' ? 10 : 2));
    }
    function vagaValida(id, tipo) {
      return id.matches(request.auth.uid + '_' + tipo + '_[0-9]{1,3}') && int(id.split('_')[2]) < limite(tipo);
    }

    // ---------------------------------------------------------------- validacoes de campos
    function texto(v, max) { return v is string && v.size() <= max; }
    function textoOuNulo(v, max) { return v == null || texto(v, max); }
    function numOuNulo(v, mn, mx) { return v == null || ((v is int || v is float) && v >= mn && v <= mx); }
    function coord(d) { return (d.lat is int || d.lat is float) && d.lat >= -90 && d.lat <= 90 && (d.lon is int || d.lon is float) && d.lon >= -180 && d.lon <= 180; }
    function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------------------------------------------------------------- usuarios
    match /users/{uid} {
      allow read: if (logado() && request.auth.uid == uid) || admin();
      // cadastro: o proprio usuario cria o perfil, sempre como cliente pendente no plano gratis
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'plan', 'status', 'criadoEm'])
        && texto(request.resource.data.name, 80) && request.resource.data.name.size() > 0
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'client' && request.resource.data.plan == 'basic' && request.resource.data.status == 'pending'
        && request.resource.data.criadoEm == request.time;
      allow update: if (logado() && request.auth.uid == uid && mudou().hasOnly(['name']) && texto(request.resource.data.name, 80))
        || (admin() && mudou().hasOnly(['status', 'plan', 'role', 'atualizadoEm'])
            && request.resource.data.status in ['pending', 'active', 'suspended']
            && request.resource.data.plan in ['basic', 'pro', 'enterprise']
            && request.resource.data.role in ['client', 'admin']);
      allow delete: if false;
    }

    // ---------------------------------------------------------------- propriedades
    function propriedadeValida(d) {
      return d.keys().hasOnly(['owner', 'name', 'crop', 'city', 'state', 'notes', 'boundary', 'areaHa', 'lat', 'lon', 'plantio', 'criadoEm', 'atualizadoEm'])
        && texto(d.name, 100) && d.name.size() > 0
        && textoOuNulo(d.get('crop', null), 60) && textoOuNulo(d.get('city', null), 60) && textoOuNulo(d.get('state', null), 2)
        && textoOuNulo(d.get('notes', null), 500) && textoOuNulo(d.get('boundary', null), 300000) && textoOuNulo(d.get('plantio', null), 10)
        && numOuNulo(d.get('areaHa', null), 0, 10000000) && numOuNulo(d.get('lat', null), -90, 90) && numOuNulo(d.get('lon', null), -180, 180);
    }
    match /properties/{pid} {
      allow read: if (ativo() && resource.data.owner == request.auth.uid) || admin();
      allow create: if ativo() && vagaValida(pid, 'p') && request.resource.data.owner == request.auth.uid && propriedadeValida(request.resource.data);
      allow update: if ativo() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid && propriedadeValida(request.resource.data);
      allow delete: if (ativo() && resource.data.owner == request.auth.uid) || admin();
    }

    // ---------------------------------------------------------------- estacoes
    function cadastroEstacao(d) {
      return texto(d.name, 100) && d.name.size() > 0 && coord(d) && numOuNulo(d.get('elevation', 0), -500, 9000)
        && d.active is bool && textoOuNulo(d.get('propertyId', null), 80)
        && textoOuNulo(d.get('deviceUid', null), 128) && textoOuNulo(d.get('deviceEmail', null), 120);
    }
    match /stations/{sid} {
      allow read: if resource.data.public == true
        || (ativo() && resource.data.owner == request.auth.uid)
        || admin()
        || (logado() && resource.data.get('deviceUid', null) == request.auth.uid);

      allow create: if
        // produtor: estacao virtual (modelo no ponto) ou sensor, numa vaga do plano
        (ativo() && vagaValida(sid, 'e')
          && request.resource.data.keys().hasOnly(['owner', 'name', 'type', 'public', 'active', 'lat', 'lon', 'elevation', 'propertyId', 'inmetCode', 'deviceUid', 'deviceEmail', 'criadoEm'])
          && request.resource.data.owner == request.auth.uid && request.resource.data.public == false
          && request.resource.data.type in ['virtual', 'sensor'] && request.resource.data.inmetCode == null
          && (request.resource.data.propertyId == null || get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.owner == request.auth.uid)
          && cadastroEstacao(request.resource.data))
        // admin: rede publica
        || (admin() && sid.matches('pub_[A-Za-z0-9_-]{1,40}')
          && request.resource.data.keys().hasOnly(['owner', 'name', 'type', 'public', 'active', 'lat', 'lon', 'elevation', 'propertyId', 'inmetCode', 'deviceUid', 'deviceEmail', 'criadoEm'])
          && request.resource.data.owner == null && request.resource.data.type == 'publica'
          && textoOuNulo(request.resource.data.get('inmetCode', null), 8) && cadastroEstacao(request.resource.data));

      allow update: if
        (ativo() && resource.data.owner == request.auth.uid
          && mudou().hasOnly(['name', 'propertyId', 'lat', 'lon', 'elevation', 'active', 'deviceUid', 'deviceEmail', 'type'])
          && request.resource.data.type in ['virtual', 'sensor']
          && (request.resource.data.get('propertyId', null) == null || get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.owner == request.auth.uid)
          && cadastroEstacao(request.resource.data))
        || (admin() && mudou().hasOnly(['name', 'propertyId', 'lat', 'lon', 'elevation', 'active', 'public', 'inmetCode', 'deviceUid', 'deviceEmail', 'type'])
          && request.resource.data.type in ['virtual', 'sensor', 'publica']
          && request.resource.data.public is bool && cadastroEstacao(request.resource.data))
        // estacao de campo: so a leitura atual, carimbada com a hora do servidor
        || (logado() && resource.data.get('deviceUid', null) == request.auth.uid && resource.data.active == true
          && mudou().hasOnly(['atual', 'ultimoDado']) && request.resource.data.ultimoDado == request.time
          && request.resource.data.atual is map);

      allow delete: if (ativo() && resource.data.owner == request.auth.uid) || admin();

      // um documento por dia: h = mapa de horas 'HH' -> medias; resumo/reserva gravados pelo job
      match /dias/{dia} {
        allow read: if legivel(sid);
        allow create: if dispositivoDe(sid) && dia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['h']) && request.resource.data.h is map && request.resource.data.h.size() <= 24;
        allow update: if dispositivoDe(sid) && mudou().hasOnly(['h']) && request.resource.data.h is map && request.resource.data.h.size() <= 24;
        allow delete: if (ativo() && estacao(sid).owner == request.auth.uid) || admin();
      }
    }

    // ---------------------------------------------------------------- estado do sistema (job)
    match /sistema/{doc} {
      allow read: if admin();
      allow write: if false;
    }
  }
}
